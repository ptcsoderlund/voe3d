# Everything starting with a dot, at any depth.
# Nothing dotted belongs in this repository except git's own metadata,
# which is re-included below.
.*

# Git metadata that must stay tracked.
!.gitignore
!.gitattributes
!.gitmodules
!.mailmap
!.gitkeep
!.gitkeep.md

# Build output
/build/
/out/
/cmake-build-*/

# The compile database. CMake writes one per build tree; every project copies it
# out to sit beside its own CMakeLists.txt, so this name is matched at any depth
# and not only at the root.
compile_commands.json
