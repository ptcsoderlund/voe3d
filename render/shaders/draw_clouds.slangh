// The clouds' two full-screen stages (ADR-0492 point 5), both behind the sky's
// vertex stage, voe_render_sky_vertex: the march, drawn into the target's
// half-size RGBA16F clouds image, premultiplied light in RGB and transmittance
// in A; then the composite, drawn over the target after the world's blended
// draws, exposed and tone mapped as a blended mesh exit.
//
// A PART (ADR-0308): included by draw.slang at its end, after draw_sky.slangh,
// whose vertex stage and its out record both stages take, and after
// everything else they call — clouds.slangh's march and entry through
// lighting.slangh, tone.slangh's veil, haze colour and exposure, water.slangh's
// voe_water_view_distance and voe_render_premultiplied. Never compiled alone;
// its entry points are in draw.spv under the names spelled here.
//
// HALF SIZE, BECAUSE THE MARCH IS THE COST: a quarter of the pixels march, up
// to 64 steps each, and the composite's bilinear read keeps the soft shapes.
// A half-size texel covers four full ones of the pass's depth copy and marches
// to the FURTHEST of them (the least stored depth, as depth runs backwards),
// so a cloud behind any of the four is marched; the clear, 0, is no geometry
// and no limit. No depth copy (~0u) is no limit either.
//
// THE SKIP: where a texel straddles a near object and the far sky, the object's
// pixels would take the sky's cloud. The composite therefore gives nothing to a
// pixel whose own depth is nearer than where its view first meets the layer,
// voe_render_clouds_entry; a pixel inside or past that point takes the image.
//
// THE VEIL: the march's light fades towards the haze colour as the sky does
// (ADR-0418 point 2), but only over the part of the path below haze_top and
// nearer than the march's distance (tone.slangh's voe_render_haze_veil_to);
// the haze colour is weighted by the cloud's opacity, so it stays
// premultiplied. The composite exposes and tones the straight colour, light ÷
// (1 − transmittance), then premultiplies it again.
//
// A clouds image slot samples SHARP, so the bilinear read is four Loads by hand.

// The far point along a sky stage's unnormalized `direction` at stored `depth`:
// its forward part is 1, so the view distance times its length;
// VOE_RENDER_CLOUDS_NEVER for the clear, where nothing was drawn.
float voe_render_clouds_depth_reach(float depth, float3 direction)
{
	if (depth <= 0.0)
		return VOE_RENDER_CLOUDS_NEVER;
	return voe_water_view_distance(depth) * length(direction);
}

// Interleaved gradient noise (Jimenez 2014) at `pixel`, 0 to 1: the march's
// first step offset, so neighbouring texels start apart and bands become grain.
float voe_render_clouds_jitter(float2 pixel)
{
	return frac(52.9829189 *
		    frac(dot(floor(pixel), float2(0.06711056, 0.00583715))));
}

// The clouds image `image` at the full-size `pixel`, bilinear over its four
// nearest texels, clamped at the edges. Half texel i covers full pixels 2i and
// 2i + 1, so its centre is at full 2i + 1.
float4 voe_render_clouds_upsampled(uint image, float2 pixel)
{
	uint width;
	uint height;

	voe_render_textures[image].GetDimensions(width, height);
	float2 at = pixel * 0.5 - 0.5;
	float2 low = floor(at);
	float2 t = at - low;
	int2 last = int2(width, height) - 1;
	int2 a = clamp(int2(low), int2(0, 0), last);
	int2 b = clamp(int2(low) + 1, int2(0, 0), last);
	float4 top = lerp(voe_render_textures[image].Load(int3(a.x, a.y, 0)),
			  voe_render_textures[image].Load(int3(b.x, a.y, 0)), t.x);
	float4 bottom = lerp(voe_render_textures[image].Load(int3(a.x, b.y, 0)),
			     voe_render_textures[image].Load(int3(b.x, b.y, 0)), t.x);

	return lerp(top, bottom, t.y);
}

// THE MARCH, at half size: the furthest depth of the 2 × 2 under the texel as
// the reach, the march from the eye along the view, its light veiled up to
// its distance. Out: premultiplied light and transmittance.
[shader("fragment")]
float4 voe_render_clouds_march_fragment(voe_render_sky_out vertex) : SV_Target
{
	float3 direction = vertex.direction;
	uint slot = voe_render_frame.depth_copy;
	float reach = VOE_RENDER_CLOUDS_NEVER;

	if (dot(direction, direction) < VOE_LEAST)
		direction = float3(0.0, 1.0, 0.0);
	if (slot != ~0u) {
		uint width;
		uint height;
		float furthest = 1.0;

		voe_render_textures[slot].GetDimensions(width, height);
		int2 corner = int2(vertex.position.xy) * 2;
		int2 last = int2(width, height) - 1;

		for (uint k = 0; k < 4; k++) {
			int2 at = min(corner + int2(k & 1, k >> 1), last);

			furthest = min(furthest,
				       voe_render_textures[slot].Load(int3(at, 0)).r);
		}
		reach = voe_render_clouds_depth_reach(furthest, direction);
	}
	float3 view = normalize(direction);
	voe_render_clouds_marched marched = voe_render_clouds_march(
		view, reach, voe_render_clouds_jitter(vertex.position.xy));
	float f = voe_render_haze_veil_to(view, marched.distance);
	float3 light = lerp(marched.light,
			    voe_render_haze_colour() * (1.0 - marched.transmittance),
			    f);

	return float4(light, marched.transmittance);
}

// THE COMPOSITE, at full size: nothing where no clouds image is named or the
// pixel's own surface is nearer than the layer; else the image, upsampled,
// exposed and toned straight and out premultiplied, alpha 1 − transmittance.
[shader("fragment")]
float4 voe_render_clouds_composite_fragment(voe_render_sky_out vertex) : SV_Target
{
	float3 direction = vertex.direction;
	uint image = voe_render_frame.clouds_image;
	uint slot = voe_render_frame.depth_copy;

	if (image == ~0u)
		return float4(0.0, 0.0, 0.0, 0.0);
	if (dot(direction, direction) < VOE_LEAST)
		direction = float3(0.0, 1.0, 0.0);
	if (slot != ~0u) {
		float depth = voe_render_textures[slot]
				      .Load(int3(int2(vertex.position.xy), 0))
				      .r;

		if (voe_render_clouds_depth_reach(depth, direction) <
		    voe_render_clouds_entry(normalize(direction)))
			return float4(0.0, 0.0, 0.0, 0.0);
	}
	float4 clouds = voe_render_clouds_upsampled(image, vertex.position.xy);
	float coverage = saturate(1.0 - clouds.a);

	if (!(coverage > 0.0))
		return float4(0.0, 0.0, 0.0, 0.0);
	return voe_render_premultiplied(voe_render_expose(clouds.rgb / coverage),
					coverage);
}
