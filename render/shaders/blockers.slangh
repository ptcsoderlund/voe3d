// Which light blockers hold a point (ADR-0347 point 3), the shaders' one copy of
// the test. A part: included by lighting.slangh (draw.slang's pass blockers at
// binding 11) and by bounce_relight.slang (its record's), each before
// bounce_read.slangh, which gates probes by it; never compiled alone.
//
// render/src/light_blockers.c is its twin on the CPU and tests/light_blockers.c
// checks that one: the same sphere, the same rows, the face counted as inside,
// so a lamp's mask from pass begin and a surface's here agree. Change one,
// change the other.
//
// A LIST IS WHATEVER THE INCLUDER SUPPLIES. voe_render_blocker_list hands out a
// blocker's sphere and rows by index; the draw reads its pass's region, the
// relight its record, and neither copies the array.
//
// BIT i IS BLOCKER i: outside its bounding sphere (xyz centre, w radius) is
// outside with one compare; inside it, inside when every row's
// |row.xyz · p + row.w| is at most 1. A count of nought is mask 0.
//
// CONSTRAINTS. count × one compare a point, three dot products more per sphere
// it is in; at most 32 blockers, one bit each.

// A list of blockers, at most 32: how many, and blocker i's sphere and row r.
interface voe_render_blocker_list {
	uint count();
	float4 sphere(uint i);
	float4 row(uint i, uint r);
}

// Whether blocker `i` of `list` holds `p`: the sphere first, then the rows.
bool voe_render_blocker_holds<L : voe_render_blocker_list>(L list, uint i, float3 p)
{
	float4 sphere = list.sphere(i);
	float3 d = p - sphere.xyz;

	if (dot(d, d) > sphere.w * sphere.w)
		return false;
	for (uint r = 0; r < 3; r++) {
		float4 row = list.row(i, r);

		if (abs(dot(row.xyz, p) + row.w) > 1.0)
			return false;
	}
	return true;
}

// The mask of the blockers of `list` that hold `p`, bit i for blocker i.
uint voe_render_blockers_mask<L : voe_render_blocker_list>(L list, float3 p)
{
	uint count = min(list.count(), 32u);
	uint mask = 0;

	for (uint i = 0; i < count; i++)
		if (voe_render_blocker_holds(list, i, p))
			mask |= 1u << i;
	return mask;
}
