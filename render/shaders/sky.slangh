// The sky's sun and its radiance along a view, in Slang (ADR-0406 point 2,
// ADR-0407 points 2 to 5): the twin of voe_render_sky_sun and
// voe_render_sky_radiance in render/src/sky.h and sky.c, the same curves, the
// same constants and the same arithmetic, so the drawn sky and the CPU's agree
// within 2/255. A change there is made here too; sky.h holds the model's words.
// A part (ADR-0308): included by lighting.slangh and tone.slangh after
// bindings.slangh, whose voe_render_sky and voe_render_light it reads, once by
// its #pragma once; never compiled alone.
//
//     float3 sun = voe_render_sky_sun(light);
//     float3 l = voe_render_sky_radiance(voe_render_frame.sky, light.direction,
//                                        sun, view);
//
// An authored gradient from ground through horizon to zenith, shifted towards
// evening by `sunset` as the sun lowers, plus a glow and a disc in the sun's
// colour. `direction` is where the sun's light travels (the sun at
// −direction), normalized here and never read when `sun` is nought; `view` a
// unit direction, both world space, +Y up. A sun of nought, an unshaded or dark
// light's, is the authored gradient alone, never black.
#pragma once

static const float VOE_RENDER_SKY_PI = 3.14159265358979;
static const float3 VOE_RENDER_SKY_WARM = float3(1.0, 0.38, 0.12);
static const float VOE_RENDER_SKY_EVENING_HEIGHT = 0.3;
static const float VOE_RENDER_SKY_NIGHT_DEPTH = 0.2;
static const float VOE_RENDER_SKY_EVENING_DIM = 0.4;
static const float VOE_RENDER_SKY_NIGHT_DIM = 0.9;
static const float VOE_RENDER_SKY_GLOW_NARROW = 256.0;
static const float VOE_RENDER_SKY_GLOW_WIDE = 4.0;
static const float VOE_RENDER_SKY_DISC_GAIN = 4.0;
static const float VOE_RENDER_SKY_DISC_EDGE = 1.1;
static const float VOE_RENDER_SKY_GROUND_FADE = 10.0;

// `light`'s colour when on (shaded, of intensity, colour and direction), else
// nought.
float3 voe_render_sky_sun(voe_render_light light)
{
	bool on = light.unshaded == 0 && light.intensity > 0.0 &&
		  any(light.colour > 0.0) &&
		  dot(light.direction, light.direction) > 0.0;

	return on ? light.colour : float3(0.0, 0.0, 0.0);
}

float3 voe_render_sky_radiance(voe_render_sky sky, float3 direction, float3 sun,
			       float3 view)
{
	bool on = any(sun > 0.0);
	float3 s = float3(0.0, 1.0, 0.0);

	if (on)
		s = -normalize(direction);
	float e = s.y;
	float h = view.y;
	float toward = dot(view, s);
	float k = 0.0;
	float n = 0.0;

	if (on) {
		k = sky.sunset * saturate((VOE_RENDER_SKY_EVENING_HEIGHT - e) /
					  VOE_RENDER_SKY_EVENING_HEIGHT);
		n = sky.sunset * saturate(-e / VOE_RENDER_SKY_NIGHT_DEPTH);
	}
	float side = 0.5 + 0.5 * toward;
	float brightest = max(sky.horizon.r, max(sky.horizon.g, sky.horizon.b));
	float3 horizon = lerp(sky.horizon, VOE_RENDER_SKY_WARM * brightest,
			      k * side * side);
	float3 radiance;

	if (h >= 0.0)
		radiance = lerp(horizon, sky.zenith,
				pow(h, 4.0 * sky.horizon_height + 1.0 / 16.0));
	else
		radiance = lerp(horizon, sky.ground,
				saturate(-VOE_RENDER_SKY_GROUND_FADE * h));
	radiance *= (1.0 - VOE_RENDER_SKY_EVENING_DIM * k) *
		    (1.0 - VOE_RENDER_SKY_NIGHT_DIM * n);
	if (!on)
		return radiance;
	radiance += sun * sky.sun_glow *
		    pow(saturate(toward),
			VOE_RENDER_SKY_GLOW_NARROW -
				(VOE_RENDER_SKY_GLOW_NARROW -
				 VOE_RENDER_SKY_GLOW_WIDE) * sky.sun_glow) *
		    (1.0 - n);
	if (sky.sun_size > 0.0 && h >= 0.0) {
		float r = sky.sun_size * (VOE_RENDER_SKY_PI / 180.0);

		radiance += sun * VOE_RENDER_SKY_DISC_GAIN *
			    smoothstep(cos(VOE_RENDER_SKY_DISC_EDGE * r), cos(r),
				       toward) *
			    (1.0 - n);
	}
	return radiance;
}
