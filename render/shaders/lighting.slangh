// The directional lights and what they light by: glTF's BRDF terms, the shadow
// lookup over the cascades, each light's radiance, the bounce, the fills and the
// point lights. A part (ADR-0308): included by draw.slang after bindings.slangh,
// whose frame block, lights, cascades, bounce volumes, point lights and blockers
// it reads; includes point_shadow.slangh, blockers.slangh and bounce_read.slangh;
// never compiled alone. draw.slang's fragment stage and water.slangh light by it.
//
// SEVERAL DIRECTIONAL LIGHTS, EACH GATED, SHADOWED AND FILLED BY ITS OWN
// (ADR-0357 point 2). Light 0 is the frame block's `light`, `shadow` and the
// region's `sun` mask; light i is `more[i − 1]`. voe_render_directionals loops
// over 1 + more_count of them, a fixed VOE_RENDER_DIRECTIONAL_LIGHTS with an
// early break, and sums each one's BRDF times its radiance by its reach, N·L
// times its shadow. The indirect term is `base colour × max(E/π, Σ fill weight ×
// fill)` per channel: E the bounce's irradiance out of the pass's probe volume
// (ADR-0326 point 7), no gain (0317), and the fills a floor under it (0307). A
// light's weight is whole where it does not reach, fading as its reach rises and
// gone from 0.3 (ADR-0276); a fill of zero is no floor. more_count 0 is the
// picture of one light. The water path lights by light 0 alone.
//
// POINT LIGHTS ADD TO THE DIRECT TERM (ADR-0320): voe_render_points, the same
// BRDF towards each light, times N·L, its colour and saturate(1 −
// (d/range)^(2/falloff))² (ADR-0322), over the lights its tile's and slice's
// masks hold (binding 8, render/src/light_bins.c). A slotted light's term is
// times lerp(1, visibility, strength), one compare on its face at binding 9
// (0325). No part in the fills or the bounce; the water path does not call it.
//
// LIGHT BLOCKERS GATE LIGHT BY ROOMS AND CROSSINGS (ADR-0350 points 3, 4). The
// lit path takes its surface's mask once, voe_render_surface_mask, at p pushed
// VOE_RENDER_LIGHT_BLOCKER_PUSH along its geometric normal, over the pass's
// region at binding 11. A light's direct term is nought unless
// voe_render_blockers_pass holds with its own mask as source along its own
// segment; a point light's with its mask from pass begin and its position. A
// light's fill reaches when p's Room bits are its own and p is in no Indoors
// box, its fade reading the reach after the gate. The bounce reads only probes
// that rule passes to p (bounce_read.slangh). The water path takes mask 0 and
// no gate. No blockers is every gate passing.
//
// THE BOUNCE IS READ ONLY WHEN THE PASS NAMES A VOLUME: grid ~0u is none.
// Otherwise bounce_read.slangh reads its sum at binding 6's four entries from
// `grid` and its moments at binding 10's grid / 4, with visibility (ADR-0312).
//
// EACH LIGHT CASTS THROUGH CASCADED SHADOW MAPS (ADR-0258, 0357 point 3). With
// its shadow `count` above nought, a lit surface picks the first cascade whose
// split is past its view distance, pushes itself one texel along its normal,
// projects into that cascade and averages a 3×3 of comparison lookups on layer
// slot × 4 + cascade; past the last split it is fully lit. The direct term and
// the reach that turns the fill away are both multiplied by it.
//
// METALNESS-ROUGHNESS, glTF'S MODEL AND THEREFORE THE IMPORTER'S: base colour,
// metalness, roughness and occlusion from the shading record and three maps.
//
// THE ARITHMETIC IS THE glTF SPECIFICATION'S BRDF, WRITTEN OUT. GGX, Smith's
// height-correlated visibility with the specular denominator folded in, and
// Schlick's Fresnel; the diffuse half is Lambert, scaled by what the Fresnel
// term did not reflect. When a highlight is wrong, look at `roughness *
// roughness`: alpha is roughness squared, and using roughness directly makes
// every surface too shiny with no maths going wrong to say so.

#include "point_shadow.slangh"
#include "blockers.slangh"
#include "bounce_read.slangh"

static const float VOE_PI = 3.14159265358979;

// What a non-metal reflects head-on: four per cent, which is glass, plastic,
// stone, skin and very nearly everything else that is not a metal. A metal's
// answer is its own base colour instead, which is what metalness interpolates
// towards.
static const float VOE_DIELECTRIC_REFLECTANCE = 0.04;

// Nothing here divides by a number that came out of a file without this under
// it. A grazing angle sends the visibility term's denominator to zero and one
// NaN fragment is a black or white speck that moves with the camera.
static const float VOE_LEAST = 1e-7;

// The sun's reach, N·L times its shadow, at which the fill is gone (ADR-0276).
// Below it the fill fades in along a smoothstep, so neither a shadow's soft
// edge nor the terminator shows a seam; above it a surface is the sun's alone.
static const float VOE_FILL_FADE_REACH = 0.3;

// Schlick's approximation: how much more a surface reflects at a grazing angle
// than head-on. The fifth power is the approximation and not a tunable.
float3 voe_render_fresnel(float3 f0, float cosine)
{
	float factor = pow(saturate(1.0 - cosine), 5.0);

	return f0 + (1.0 - f0) * factor;
}

// Trowbridge-Reitz, which everyone calls GGX: how much of the surface's
// microscopic facets point at the half vector. `alpha` is roughness squared —
// see the note at the top of this file.
float voe_render_distribution(float n_dot_h, float alpha)
{
	float a2 = alpha * alpha;
	float d = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;

	return a2 / max(VOE_PI * d * d, VOE_LEAST);
}

// Smith's height-correlated visibility, which is the shadowing-masking term with
// the specular denominator 4·(n·l)·(n·v) folded into it. Folded because the two
// cancel: written separately they are a division by something that goes to zero
// at exactly the angles where the other factor does.
float voe_render_visibility(float n_dot_l, float n_dot_v, float alpha)
{
	float a2 = alpha * alpha;
	float lambda_l = n_dot_l * sqrt(n_dot_v * n_dot_v * (1.0 - a2) + a2);
	float lambda_v = n_dot_v * sqrt(n_dot_l * n_dot_l * (1.0 - a2) + a2);

	return 0.5 / max(lambda_l + lambda_v, VOE_LEAST);
}

// Directional light `i` of the pass: the frame block's `light` for nought,
// `more[i − 1]` after it (ADR-0357).
voe_render_light voe_render_directional(uint i)
{
	if (i == 0)
		return voe_render_frame.light;
	return voe_render_frame.more[i - 1].light;
}

// Directional light `i`'s shadow record, as voe_render_directional picks.
voe_render_shadow voe_render_directional_shadow(uint i)
{
	if (i == 0)
		return voe_render_frame.shadow;
	return voe_render_frame.more[i - 1].shadow;
}

// The mask of the blockers holding directional light `i`'s place: the region's
// `sun` for nought, nought with no blockers.
uint voe_render_directional_source(uint i)
{
	if (voe_render_frame.blockers == 0)
		return 0;
	if (i == 0)
		return voe_render_light_blockers[voe_render_frame.region].sun;
	return voe_render_frame.more[i - 1].blockers;
}

// How much of the light whose cascades `shadow` holds reaches `world`, nought
// to one, read from layer slot × 4 + cascade. See the header's cascade
// paragraph; one is the answer with no cascades and past the last split.
//
// THE ONE Y FLIP: clip +y is row 0 of the map, because the shadow pass drew
// through the engine's flipped viewport, so v runs opposite to clip y.
float voe_render_sunlight(voe_render_shadow shadow, float3 world, float3 normal)
{
	float distance = -mul(voe_render_frame.camera.view, float4(world, 1.0)).z;
	uint cascade = 0;

	while (cascade < shadow.count && distance > shadow.splits[cascade])
		cascade++;
	if (cascade >= shadow.count)
		return 1.0;

	float3 pushed = world + normal * shadow.texels[cascade];
	float4 clip = mul(shadow.cascades[cascade], float4(pushed, 1.0));
	float3 ndc = clip.xyz / clip.w;
	float2 uv = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
	float width;
	float height;
	float layers;

	voe_render_shadow_maps.GetDimensions(width, height, layers);
	float2 step = float2(1.0 / width, 1.0 / height);
	float layer = float(shadow.slot * 4 + cascade);
	float lit = 0.0;

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			float3 at = float3(uv + float2(x, y) * step, layer);
			lit += voe_render_shadow_maps.SampleCmpLevelZero(at, ndc.z);
		}
	}
	return lit / 9.0;
}

// The pass's blockers, its region at binding 11, as blockers.slangh's list.
struct voe_render_pass_blockers : voe_render_blocker_list {
	uint count()
	{
		return min(voe_render_frame.blockers, VOE_RENDER_LIGHT_BLOCKERS);
	}
	float4 sphere(uint i)
	{
		return voe_render_light_blockers[voe_render_frame.region]
			.blockers[i]
			.sphere;
	}
	float4 row(uint i, uint r)
	{
		return voe_render_light_blockers[voe_render_frame.region]
			.blockers[i]
			.rows[r];
	}
};

// The mask of a surface at `world` with geometric normal `surface`, pushed off
// it so a wall on a box's face is inside on one side only. See the header.
uint voe_render_surface_mask(float3 world, float3 surface)
{
	voe_render_pass_blockers blockers;

	if (voe_render_frame.blockers == 0)
		return 0;
	return voe_render_blockers_mask(
		blockers, world + surface * VOE_RENDER_LIGHT_BLOCKER_PUSH);
}

// Whether the direct light of a directional light travelling `direction`, its
// place held by the blockers of `source`, reaches a surface at `world` with
// geometric normal `surface` and mask `mask` along the light's own segment
// (ADR-0350 point 3). See the header.
bool voe_render_sun_passes(float3 world, float3 surface, uint mask, uint source,
			   float3 direction)
{
	voe_render_pass_blockers blockers;
	uint region = voe_render_frame.region;

	if (voe_render_frame.blockers == 0)
		return true;
	float3 p = world + surface * VOE_RENDER_LIGHT_BLOCKER_PUSH;

	return voe_render_blockers_pass(
		blockers, voe_render_light_blockers[region].walls,
		voe_render_light_blockers[region].indoors, source, mask, p,
		voe_render_sun_segment_end(p, direction));
}

// Whether the fill of a light whose place the blockers of `source` hold reaches
// a surface whose mask is `mask` (ADR-0350 point 4): its Room bits the light's,
// and in no Indoors box. See the header.
bool voe_render_fill_reaches(uint mask, uint source)
{
	uint region = voe_render_frame.region;

	if (voe_render_frame.blockers == 0)
		return true;
	uint indoors = voe_render_light_blockers[region].indoors;
	uint rooms = ~(voe_render_light_blockers[region].walls | indoors);

	return (mask & rooms) == (source & rooms) && (mask & indoors) == 0;
}

// `light`'s direct light at a surface it reaches by `reach`, N·L times its
// shadow, nought where its gate stops it: its colour times its strength times
// that.
float3 voe_render_sun_radiance(voe_render_light light, float reach)
{
	return light.colour * light.intensity * reach;
}

// `light`'s fill as a floor under the bounce at a surface it reaches by
// `reach`: whole at nought, faded along a smoothstep, gone from
// VOE_FILL_FADE_REACH, and none unless `reaches`. See the header.
float3 voe_render_fill(voe_render_light light, float reach, bool reaches)
{
	float weight = !reaches ? 0.0 :
			      1.0 - smoothstep(0.0, VOE_FILL_FADE_REACH, reach);

	return weight * light.fill;
}

// The bounce's irradiance E(n) at `world` facing `n`, per channel, never below
// nought, from the probes the blockers pass to a surface of `mask`; nought
// with no volume named. See the header.
float3 voe_render_bounce_irradiance(float3 world, float3 n, uint mask)
{
	voe_render_frame_bounce bounce = voe_render_frame.bounce;
	voe_render_pass_blockers blockers;
	uint region = voe_render_frame.region;

	if (bounce.grid == ~0u)
		return float3(0.0, 0.0, 0.0);
	return voe_render_bounce_read(voe_render_bounce_grids[bounce.grid],
				      voe_render_bounce_grids[bounce.grid + 1],
				      voe_render_bounce_grids[bounce.grid + 2],
				      voe_render_bounce_grids[bounce.grid + 3],
				      voe_render_bounce_moments[bounce.grid / 4],
				      bounce.corner, bounce.cell, bounce.spacing,
				      blockers, voe_render_light_blockers[region].walls,
				      voe_render_light_blockers[region].indoors, mask,
				      world, n);
}

// What lights `colour` besides the direct terms: the bounce from the probes of
// `mask`, with `fill`, the lights' summed voe_render_fill, a floor under it.
// See the header.
float3 voe_render_indirect(float3 fill, float3 world, float3 n, float3 colour,
			   uint mask = 0)
{
	float3 bounce = voe_render_bounce_irradiance(world, n, mask) / VOE_PI;

	return colour * max(bounce, fill);
}

// What the pass's directional lights give a surface at `world` (`surface` its
// geometric normal, `mask` its blockers) facing `n`, seen along `v`: the sum of
// each light's BRDF times its radiance by its reach, N·L times its own shadow,
// nought where its own gate stops it; and into `fill` the sum of each one's
// fill by that reach and its own gate. See the header.
float3 voe_render_directionals(float3 world, float3 surface, float3 n, float3 v,
			       float3 diffuse_colour, float3 f0, float alpha,
			       uint mask, out float3 fill)
{
	float n_dot_v = saturate(dot(n, v));
	float3 sum = float3(0.0, 0.0, 0.0);

	fill = float3(0.0, 0.0, 0.0);
	for (uint i = 0; i < VOE_RENDER_DIRECTIONAL_LIGHTS; i++) {
		if (i > voe_render_frame.more_count)
			break;
		voe_render_light light = voe_render_directional(i);
		uint source = voe_render_directional_source(i);
		// Towards the light, the opposite of the way it travels.
		float3 l = -light.direction;
		float3 h = normalize(l + v);
		float n_dot_l = saturate(dot(n, l));
		float3 fresnel = voe_render_fresnel(f0, saturate(dot(v, h)));
		float3 specular = fresnel *
				  voe_render_distribution(saturate(dot(n, h)), alpha) *
				  voe_render_visibility(n_dot_l, n_dot_v, alpha);
		// What the Fresnel term did not reflect is what the diffuse half
		// has, which keeps this from adding energy the light did not have.
		float3 diffuse = (1.0 - fresnel) * diffuse_colour / VOE_PI;
		float reach = 0.0;

		if (voe_render_sun_passes(world, surface, mask, source,
					  light.direction))
			reach = n_dot_l *
				voe_render_sunlight(voe_render_directional_shadow(i),
						    world, surface);
		sum += (diffuse + specular) * voe_render_sun_radiance(light, reach);
		fill += voe_render_fill(light, reach,
					voe_render_fill_reaches(mask, source));
	}
	return sum;
}

// The depth slice of view distance `distance`: voe_render_light_slice in
// render/src/light_bins.c, the same exponential and the same clamps.
uint voe_render_light_slice(float distance)
{
	if (!(distance > VOE_RENDER_LIGHT_SLICE_NEAR))
		return 0;
	if (distance >= VOE_RENDER_LIGHT_SLICE_FAR)
		return VOE_RENDER_LIGHT_SLICES - 1;
	float s = log(distance / VOE_RENDER_LIGHT_SLICE_NEAR) /
		  log(VOE_RENDER_LIGHT_SLICE_FAR / VOE_RENDER_LIGHT_SLICE_NEAR) *
		  float(VOE_RENDER_LIGHT_SLICES);
	return s >= float(VOE_RENDER_LIGHT_SLICES - 1) ? VOE_RENDER_LIGHT_SLICES - 1 :
							 uint(s);
}

// One tile's or slice's index along an axis of `tiles`, from an NDC coordinate.
uint voe_render_light_tile(float ndc, uint tiles)
{
	float t = (ndc + 1.0) * 0.5 * float(tiles);

	return uint(clamp(t, 0.0, float(tiles - 1)));
}

// How much of slotted point light `light` reaches `world`, nought to one: the
// face (surface − light) points through, the surface pushed one texel along its
// geometric normal `surface` — a face texel spans 2·d / size metres at distance
// d along the face's axis, the size the map's own — so it does not shadow
// itself, then one hardware-filtered compare on layer 6(slot − 1) + face. The
// v flip is point_shadow.slangh's.
float voe_render_point_visibility(voe_render_point_light light, float3 world,
				  float3 surface)
{
	float width;
	float height;
	float layers;

	voe_render_point_shadow_maps.GetDimensions(width, height, layers);
	float3 to = world - light.position;
	float3 a = abs(to);
	float d = max(a.x, max(a.y, a.z));
	float3 pushed = to + surface * (2.0 * d / width);
	uint face = voe_render_point_shadow_face(pushed);
	float4 clip = voe_render_point_shadow_clip(pushed, face, light.range);
	float3 ndc = clip.xyz / clip.w;
	float2 uv = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
	float layer = float(6 * (light.shadow - 1) + face);

	return voe_render_point_shadow_maps.SampleCmpLevelZero(float3(uv, layer),
							      ndc.z);
}

// What the pass's point lights add to the direct light at `world`, facing `n`
// (`surface` its geometric normal, which places a shadow lookup) and seen along
// `v`: the BRDF of each light its tile and slice both mark, times N·L, its
// colour and saturate(1 − (d/range)^(2/falloff))², the light's falloff bending
// its reach, and a slotted light's shadow; only the lights the blockers pass to
// a surface of mask `mask`. Nought with no lights. See the header.
float3 voe_render_points(float3 world, float3 surface, float3 n, float3 v,
			 float3 diffuse_colour, float3 f0, float alpha, uint mask)
{
	uint count = voe_render_frame.lights;

	if (count == 0)
		return float3(0.0, 0.0, 0.0);
	float4 eye = mul(voe_render_frame.camera.view, float4(world, 1.0));
	float4 clip = mul(voe_render_frame.camera.projection, eye);
	float2 ndc = clip.xy / clip.w;
	uint tile = voe_render_light_tile(ndc.x, VOE_RENDER_LIGHT_TILES_X) +
		    VOE_RENDER_LIGHT_TILES_X *
			    voe_render_light_tile(ndc.y, VOE_RENDER_LIGHT_TILES_Y);
	uint slice = voe_render_light_slice(-eye.z);
	uint base = voe_render_frame.region * VOE_RENDER_LIGHT_REGION;
	uint tile_at = base + tile * VOE_RENDER_LIGHT_WORDS;
	uint slice_at = base + VOE_RENDER_LIGHT_SLICE_WORDS +
			slice * VOE_RENDER_LIGHT_WORDS;
	uint first = voe_render_frame.region * VOE_RENDER_POINT_LIGHTS;
	uint region = voe_render_frame.region;
	uint walls = voe_render_light_blockers[region].walls;
	uint indoors = voe_render_light_blockers[region].indoors;
	voe_render_pass_blockers blockers;
	float3 p = world + surface * VOE_RENDER_LIGHT_BLOCKER_PUSH;
	float n_dot_v = saturate(dot(n, v));
	float3 sum = float3(0.0, 0.0, 0.0);

	for (uint w = 0; w < (count + 31) / 32 && w < VOE_RENDER_LIGHT_WORDS; w++) {
		uint bits = voe_render_light_bins[tile_at + w] &
			    voe_render_light_bins[slice_at + w];

		// At most 32 rounds: each clears the lowest set bit.
		while (bits != 0) {
			uint b = firstbitlow(bits);
			bits &= bits - 1;
			voe_render_point_light light =
				voe_render_point_lights[first + w * 32 + b];
			float3 to = light.position - world;
			float d = length(to);

			if (d >= light.range || d < VOE_LEAST)
				continue;
			if (!voe_render_blockers_pass(
				    blockers, walls, indoors,
				    voe_render_light_blockers[region].masks[w * 32 + b],
				    mask, p, light.position))
				continue;
			float3 l = to / d;
			float3 h = normalize(l + v);
			float n_dot_l = saturate(dot(n, l));
			float3 fresnel = voe_render_fresnel(f0, saturate(dot(v, h)));
			float3 specular =
				fresnel *
				voe_render_distribution(saturate(dot(n, h)), alpha) *
				voe_render_visibility(n_dot_l, n_dot_v, alpha);
			float3 diffuse = (1.0 - fresnel) * diffuse_colour / VOE_PI;
			float fade = saturate(
				1.0 - pow(d / light.range, 2.0 / light.falloff));
			float shade = 1.0;

			if (light.shadow != 0 && light.shadow_strength > 0.0)
				shade = lerp(1.0,
					     voe_render_point_visibility(
						     light, world, surface),
					     light.shadow_strength);
			sum += (diffuse + specular) * light.colour * n_dot_l *
			       fade * fade * shade;
		}
	}
	return sum;
}
